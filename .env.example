cat > .env.example << 'EOF'
# Servidor y Entorno
PORT=3000
NODE_ENV=development

# Base de Datos Local (PostgreSQL)
DB_NAME=Sistema
DB_USER=postgres
DB_PASSWORD=tu_password_postgres
DB_HOST=localhost
DB_PORT=5432

# Base de Datos en Producción (Render / Cloud)
DATABASE_URL=postgresql://usuario:pass@host:5432/basededatos

# Seguridad y Tokens JWT
# Genera aleatoriamente una cadena criptográfica de al menos 32 caracteres.
SECRET_KEY=genera_una_clave_aleatoria_de_al_menos_32_caracteres

# Cliente / Frontend
CLIENT_URL=http://localhost:5173

# Servicio de Correo SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_contraseña_de_aplicacion
EOF